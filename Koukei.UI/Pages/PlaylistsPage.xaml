<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koukei.UI.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koukei.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Koukei.UI.Helpers"
    xmlns:local="using:Koukei.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource KoukeiPageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PlaylistTemplate" x:DataType="local:PlaylistViewModel">
            <Grid
                MinHeight="84"
                Padding="8"
                AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="PlaylistsPage_Open"
                            Click="OpenPlaylistMenuFlyoutItem_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="PlaylistsPage_Rename"
                            Click="RenameMenuFlyoutItem_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlaylistsPage_EditDescription"
                            Click="EditDescriptionMenuFlyoutItem_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="PlaylistsPage_Delete"
                            Click="DeleteMenuFlyoutItem_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Foreground="{ThemeResource KoukeiCriticalBrush}" Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    x:Uid="PlaylistsPage_SelectItemCheckBox"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="PlaylistCheckBox_Click"
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    Tag="{x:Bind}" />

                <Border
                    Grid.Column="1"
                    Width="68"
                    Height="68"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{StaticResource KoukeiCornerRadiusSmall}">
                    <Grid>
                        <Image
                            Source="{x:Bind Cover1Source, Mode=OneTime}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind SingleCoverVisibility, Mode=OneTime}">
                            <Image.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.12" />
                            </Image.OpacityTransition>
                        </Image>

                        <Grid Visibility="{x:Bind DoubleCoverVisibility, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{x:Bind Cover1Source, Mode=OneTime}" Stretch="UniformToFill" />
                            <Image Grid.Column="1" Source="{x:Bind Cover2Source, Mode=OneTime}" Stretch="UniformToFill" />
                        </Grid>

                        <Grid Visibility="{x:Bind TripleCoverVisibility, Mode=OneTime}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.RowSpan="2" Source="{x:Bind Cover1Source, Mode=OneTime}" Stretch="UniformToFill" />
                            <Image Grid.Column="1" Source="{x:Bind Cover2Source, Mode=OneTime}" Stretch="UniformToFill" />
                            <Image Grid.Row="1" Grid.Column="1" Source="{x:Bind Cover3Source, Mode=OneTime}" Stretch="UniformToFill" />
                        </Grid>

                        <Grid Visibility="{x:Bind QuadCoverVisibility, Mode=OneTime}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{x:Bind Cover1Source, Mode=OneTime}" Stretch="UniformToFill" />
                            <Image Grid.Column="1" Source="{x:Bind Cover2Source, Mode=OneTime}" Stretch="UniformToFill" />
                            <Image Grid.Row="1" Source="{x:Bind Cover3Source, Mode=OneTime}" Stretch="UniformToFill" />
                            <Image Grid.Row="1" Grid.Column="1" Source="{x:Bind Cover4Source, Mode=OneTime}" Stretch="UniformToFill" />
                        </Grid>

                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8FD;"
                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneTime}" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="2"
                    Margin="12,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Name, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        helpers:LongTextToolTip.FullText="{x:Bind Name, Mode=OneTime}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        MaxLines="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind DescriptionText, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        helpers:LongTextToolTip.FullText="{x:Bind DescriptionText, Mode=OneTime}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ItemCountText, Mode=OneTime}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DateText, Mode=OneTime}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="PlaylistsPage_PlayButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="PlayPlaylistButton_Click"
                        CornerRadius="{StaticResource KoukeiCornerRadiusSmall}"
                        IsEnabled="{x:Bind HasItems, Mode=OneWay}"
                        Tag="{x:Bind}">
                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Uid="PlaylistsPage_QueueButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="QueuePlaylistButton_Click"
                        CornerRadius="{StaticResource KoukeiCornerRadiusSmall}"
                        IsEnabled="{x:Bind HasItems, Mode=OneWay}"
                        Tag="{x:Bind}">
                        <FontIcon FontSize="16" Glyph="&#xE109;" />
                    </Button>
                    <Button
                        x:Uid="PlaylistsPage_MoreButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        CornerRadius="{StaticResource KoukeiCornerRadiusSmall}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="PlaylistsPage_Rename"
                                    Click="RenameMenuFlyoutItem_Click"
                                    Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="PlaylistsPage_EditDescription"
                                    Click="EditDescriptionMenuFlyoutItem_Click"
                                    Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Uid="PlaylistsPage_Delete"
                                    Click="DeleteMenuFlyoutItem_Click"
                                    Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Foreground="{ThemeResource KoukeiCriticalBrush}" Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="HeaderPanel"
            Padding="24,20,24,0"
            Spacing="{StaticResource KoukeiPageBlockSpacing}">
            <TextBlock
                x:Uid="PlaylistsPage_Title"
                AutomationProperties.AutomationId="PagePlaylists"
                Style="{StaticResource KoukeiPageTitleTextStyle}" />

            <Grid x:Name="CommandArea" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="PrimaryCommands" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CreatePlaylistButton"
                        AutomationProperties.AutomationId="CreatePlaylist"
                        Click="CreatePlaylistButton_Click"
                        MinHeight="40"
                        Style="{StaticResource KoukeiAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock x:Uid="PlaylistsPage_CreatePlaylistText" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="RefreshButton"
                        x:Uid="PlaylistsPage_Refresh"
                        Click="RefreshButton_Click"
                        Style="{StaticResource KoukeiIconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>

                <Grid
                    x:Name="SearchAndSortPanel"
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="PlaylistsPage_SearchPlaceholder"
                        Width="300"
                        MinHeight="40"
                        VerticalContentAlignment="Center"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />

                    <Button
                        x:Name="SortButton"
                        x:Uid="PlaylistsPage_SortButton"
                        Grid.Column="1"
                        MinHeight="40"
                        Padding="10,0"
                        VerticalAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Uid="PlaylistsPage_SortField_Name"
                                    GroupName="PlaylistSortField"
                                    IsChecked="True"
                                    Tag="Name"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="PlaylistsPage_SortField_Modified"
                                    GroupName="PlaylistSortField"
                                    Tag="Modified"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="PlaylistsPage_SortField_Created"
                                    GroupName="PlaylistSortField"
                                    Tag="Created"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="PlaylistsPage_SortField_ItemCount"
                                    GroupName="PlaylistSortField"
                                    Tag="ItemCount"
                                    Click="SortMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <RadioMenuFlyoutItem
                                    x:Uid="LibraryPage_SortDirection_Ascending"
                                    GroupName="PlaylistSortDirection"
                                    IsChecked="True"
                                    Tag="Ascending"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="LibraryPage_SortDirection_Descending"
                                    GroupName="PlaylistSortDirection"
                                    Tag="Descending"
                                    Click="SortMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                            <TextBlock x:Name="SortButtonLabel" VerticalAlignment="Center" />
                            <FontIcon x:Name="SortDirectionIcon" FontSize="10" Glyph="&#xE70E;" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>

        <InfoBar
            x:Name="LoadErrorInfoBar"
            Grid.Row="1"
            Margin="24,8,24,0"
            IsClosable="True"
            IsOpen="False"
            IsTabStop="True"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button
                    x:Uid="Common_RetryButton"
                    Click="RetryLoadButton_Click"
                    MinHeight="40" />
            </InfoBar.ActionButton>
        </InfoBar>

        <controls:PageStatePresenter
            x:Name="StatePresenter"
            x:Uid="PlaylistsPage_StatePresenter"
            Grid.Row="2"
            Margin="24,8,24,16"
            RetryRequested="StatePresenter_RetryRequested">
            <controls:PageStatePresenter.Body>
                <Grid>
                    <ListView
                x:Name="PlaylistList"
                Background="Transparent"
                DoubleTapped="PlaylistList_DoubleTapped"
                ItemTemplate="{StaticResource PlaylistTemplate}"
                ItemsSource="{x:Bind Playlists, Mode=OneWay}"
                KeyDown="PlaylistList_KeyDown"
                SelectionChanged="PlaylistList_SelectionChanged"
                SelectionMode="Extended">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                    </ListView>

                    <StackPanel
                x:Name="EmptyPanel"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                    Glyph="&#xE8FD;" />
                <TextBlock
                    x:Uid="PlaylistsPage_EmptyTitle"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource KoukeiSectionTitleTextStyle}" />
                <TextBlock
                    x:Uid="PlaylistsPage_EmptyDescription"
                    TextAlignment="Center"
                    Style="{StaticResource KoukeiMetadataTextStyle}" />
                <Button Click="CreatePlaylistButton_Click" MinHeight="40" Style="{StaticResource KoukeiAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock x:Uid="PlaylistsPage_CreatePlaylistText" />
                    </StackPanel>
                </Button>
                    </StackPanel>

                    <StackPanel
                x:Name="NoResultsPanel"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon FontSize="48" Glyph="&#xE721;" />
                <TextBlock
                    x:Uid="PlaylistsPage_NoResultsTitle"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource KoukeiSectionTitleTextStyle}" />
                <TextBlock
                    x:Uid="PlaylistsPage_NoResultsDescription"
                    TextAlignment="Center"
                    Style="{StaticResource KoukeiMetadataTextStyle}" />
                <Button
                    x:Uid="PlaylistsPage_ClearSearch"
                    Click="ClearSearchButton_Click"
                    MinHeight="40" />
                    </StackPanel>
                </Grid>
            </controls:PageStatePresenter.Body>
        </controls:PageStatePresenter>

        <controls:PageStatusBar
            x:Name="FooterStatusBar"
            Grid.Row="3"
            Style="{StaticResource KoukeiPageStatusBarStyle}" />
    </Grid>
</Page>
