<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koukei.UI.Pages.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koukei.UI.Controls"
    xmlns:helpers="using:Koukei.UI.Helpers"
    xmlns:local="using:Koukei.UI.Pages"
    Background="{ThemeResource KoukeiPageBackgroundBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Enter" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="KeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="KeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="PlaylistMediaItemTemplate" x:DataType="local:PlaylistDetailItemViewModel">
            <Grid
                MinHeight="84"
                Padding="8"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                Background="Transparent"
                Tag="{x:Bind}">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="PlaylistDetailPage_PlayItem"
                            Click="PlayItemMenuFlyoutItem_Click"
                            IsEnabled="{x:Bind IsPlayable, Mode=OneWay}"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Uid="PlaylistDetailPage_QueueItem"
                            Click="QueueItemMenuFlyoutItem_Click"
                            IsEnabled="{x:Bind IsPlayable, Mode=OneWay}"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="PlaylistDetailPage_RemoveItem"
                            Click="RemoveItemMenuFlyoutItem_Click"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Foreground="{ThemeResource KoukeiCriticalBrush}" Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="3"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="2"
                    Visibility="{x:Bind CurrentIndicatorVisibility, Mode=OneWay}" />

                <CheckBox
                    x:Uid="PlaylistDetailPage_SelectItemCheckBox"
                    Grid.Column="1"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="ItemCheckBox_Click"
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    Tag="{x:Bind}" />

                <Border
                    Grid.Column="2"
                    Width="{x:Bind ThumbnailWidth, Mode=OneWay}"
                    Height="68"
                    Margin="8,0,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{StaticResource KoukeiCornerRadiusSmall}">
                    <Grid>
                        <Image
                            IsHitTestVisible="False"
                            Opacity="{x:Bind ThumbnailOpacity, Mode=OneWay}"
                            Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                            Stretch="UniformToFill">
                            <Image.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.12" />
                            </Image.OpacityTransition>
                        </Image>
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind KindGlyph, Mode=OneWay}"
                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="3"
                    Margin="12,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        MaxLines="1"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        helpers:LongTextToolTip.FullText="{x:Bind Title, Mode=OneWay}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            MaxWidth="260"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind SecondaryText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            helpers:LongTextToolTip.FullText="{x:Bind FilePath, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DurationText, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind KindLabel, Mode=OneWay}" />
                        <FontIcon
                            x:Uid="PlaylistDetailPage_UnavailableItem"
                            FontSize="12"
                            Foreground="{ThemeResource KoukeiCriticalBrush}"
                            Glyph="&#xE783;"
                            Visibility="{x:Bind UnavailableVisibility, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="HeaderPanel"
            Padding="24,20,24,0"
            Spacing="{StaticResource KoukeiPageBlockSpacing}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    x:Uid="PlaylistDetailPage_BackButton"
                    VerticalAlignment="Top"
                    Click="BackButton_Click"
                    Style="{StaticResource KoukeiIconButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        Style="{StaticResource KoukeiPageTitleTextStyle}"
                        Text="{x:Bind PlaylistName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource KoukeiMetadataTextStyle}"
                        Text="{x:Bind PlaylistDescription, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords"
                        helpers:LongTextToolTip.FullText="{x:Bind PlaylistDescription, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="CommandArea" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="PrimaryCommands" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AddFilesButton"
                        x:Uid="PlaylistDetailPage_AddFilesButton"
                        MinHeight="40"
                        Click="AddFilesButton_Click"
                        Style="{StaticResource KoukeiAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                            <TextBlock x:Uid="PlaylistDetailPage_AddFiles" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="AddFolderButton"
                        x:Uid="PlaylistDetailPage_AddFolderButton"
                        MinHeight="40"
                        Click="AddFolderButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                            <TextBlock x:Uid="PlaylistDetailPage_AddFolder" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="RefreshButton"
                        x:Uid="PlaylistDetailPage_RefreshButton"
                        Click="RefreshButton_Click"
                        Style="{StaticResource KoukeiIconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>

                <Grid
                    x:Name="SearchAndSortPanel"
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="PlaylistDetailPage_SearchBox"
                        Width="300"
                        MinHeight="40"
                        VerticalContentAlignment="Center"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />

                    <Button
                        x:Name="SortButton"
                        x:Uid="PlaylistDetailPage_SortButton"
                        Grid.Column="1"
                        MinHeight="40"
                        Padding="10,0"
                        VerticalAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Uid="PlaylistDetailPage_SortField_PlaylistOrder"
                                    GroupName="PlaylistDetailSortField"
                                    IsChecked="True"
                                    Tag="PlaylistOrder"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="LibraryPage_SortField_Title"
                                    GroupName="PlaylistDetailSortField"
                                    Tag="Title"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="LibraryPage_SortField_Duration"
                                    GroupName="PlaylistDetailSortField"
                                    Tag="Duration"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="PlaylistDetailPage_SortField_Kind"
                                    GroupName="PlaylistDetailSortField"
                                    Tag="Kind"
                                    Click="SortMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <RadioMenuFlyoutItem
                                    x:Uid="LibraryPage_SortDirection_Ascending"
                                    GroupName="PlaylistDetailSortDirection"
                                    IsChecked="True"
                                    Tag="Ascending"
                                    Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Uid="LibraryPage_SortDirection_Descending"
                                    GroupName="PlaylistDetailSortDirection"
                                    Tag="Descending"
                                    Click="SortMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                            <TextBlock x:Name="SortButtonLabel" VerticalAlignment="Center" />
                            <FontIcon x:Name="SortDirectionIcon" FontSize="10" Glyph="&#xE70E;" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>

        <InfoBar
            x:Name="OperationInfoBar"
            Grid.Row="1"
            Margin="24,8,24,0"
            IsClosable="True"
            IsOpen="False"
            IsTabStop="True"
            Severity="Error" />

        <Grid
            x:Name="ContentRegion"
            Grid.Row="2"
            Padding="24,0,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="StatisticsBar"
                MinHeight="56"
                Margin="0,0,0,8"
                Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="StatisticsPanel"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource KoukeiPageBlockSpacing}">
                    <TextBlock>
                        <Run x:Uid="PlaylistDetailPage_TotalCounts" />
                        <Run x:Name="TotalCountText" FontWeight="Bold" Text="0" />
                    </TextBlock>
                    <TextBlock AutomationProperties.LiveSetting="Polite">
                        <Run x:Uid="PlaylistDetailPage_SelectedCounts" />
                        <Run x:Name="SelectedCountText" FontWeight="Bold" Text="0" />
                    </TextBlock>
                </StackPanel>

                <controls:ResponsiveCommandBar
                    x:Name="SelectionActionBar"
                    Grid.Column="1"
                    MinHeight="48"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    IsDynamicOverflowEnabled="True"
                    Visibility="Collapsed">
                    <controls:ResponsiveCommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">4</Thickness>
                    </controls:ResponsiveCommandBar.Resources>
                    <AppBarButton
                        x:Name="PlaySelectedButton"
                        x:Uid="PlaylistDetailPage_PlaySelected"
                        Click="PlaySelectedButton_Click"
                        Icon="Play"
                        Style="{StaticResource KoukeiCommandBarIconButtonStyle}" />
                    <AppBarButton
                        x:Name="QueueSelectedButton"
                        x:Uid="PlaylistDetailPage_QueueSelected"
                        Click="QueueSelectedButton_Click"
                        Style="{StaticResource KoukeiCommandBarIconButtonStyle}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE109;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RemoveSelectedButton"
                        x:Uid="PlaylistDetailPage_RemoveSelected"
                        Click="RemoveSelectedButton_Click"
                        Icon="Delete"
                        Style="{StaticResource KoukeiCommandBarIconButtonStyle}" />
                    <AppBarButton
                        x:Uid="PlaylistDetailPage_ClearSelection"
                        Click="ClearSelectionButton_Click"
                        Icon="Clear"
                        Style="{StaticResource KoukeiCommandBarIconButtonStyle}" />
                </controls:ResponsiveCommandBar>
            </Grid>

            <controls:PageStatePresenter
                x:Name="StatePresenter"
                x:Uid="PlaylistDetailPage_StatePresenter"
                Grid.Row="1"
                RetryRequested="StatePresenter_RetryRequested">
                <controls:PageStatePresenter.Body>
                    <ListView
                        x:Name="ItemList"
                        AllowDrop="True"
                        Background="Transparent"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DoubleTapped="ItemList_DoubleTapped"
                        DragItemsCompleted="ItemList_DragItemsCompleted"
                        DragItemsStarting="ItemList_DragItemsStarting"
                        IsMultiSelectCheckBoxEnabled="False"
                        ItemTemplate="{StaticResource PlaylistMediaItemTemplate}"
                        ItemsSource="{x:Bind Items, Mode=OneWay}"
                        KeyDown="ItemList_KeyDown"
                        ReorderMode="Enabled"
                        SelectionChanged="ItemList_SelectionChanged"
                        SelectionMode="Extended">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                    </ListView>
                </controls:PageStatePresenter.Body>
            </controls:PageStatePresenter>
        </Grid>

        <controls:PageStatusBar
            x:Name="FooterStatusBar"
            Grid.Row="3"
            Style="{StaticResource KoukeiPageStatusBarStyle}" />
    </Grid>
</Page>
