<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Koukei.UI.Controls.PlayerSeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyDown="PlayerSeekBar_KeyDown"
    MinHeight="40">

    <Grid
        x:Name="InputSurface"
        MinHeight="40"
        Background="Transparent"
        PointerCanceled="InputSurface_PointerCanceled"
        PointerCaptureLost="InputSurface_PointerCaptureLost"
        PointerEntered="InputSurface_PointerEntered"
        PointerExited="InputSurface_PointerExited"
        PointerMoved="InputSurface_PointerMoved"
        PointerPressed="InputSurface_PointerPressed"
        PointerReleased="InputSurface_PointerReleased"
        SizeChanged="InputSurface_SizeChanged">
        <Canvas x:Name="VisualCanvas">
            <Border
                x:Name="TrackBackground"
                Background="{ThemeResource KoukeiTextSecondaryBrush}"
                Opacity="0.45"
                CornerRadius="2"
                IsHitTestVisible="False" />

            <Border
                x:Name="ProgressTrack"
                Width="0"
                Background="{ThemeResource KoukeiPlaybackAccentBrush}"
                CornerRadius="2"
                IsHitTestVisible="False" />

            <Canvas
                x:Name="ChapterCanvas"
                IsHitTestVisible="True" />

            <Ellipse
                x:Name="Thumb"
                Fill="{ThemeResource KoukeiTextPrimaryBrush}"
                IsHitTestVisible="False" />
        </Canvas>
    </Grid>
</UserControl>
