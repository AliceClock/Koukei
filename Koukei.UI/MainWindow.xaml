<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Koukei.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koukei.UI.Controls"
    xmlns:helpers="using:Koukei.UI.Helpers"
    xmlns:local="using:Koukei.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Koukei.UI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="MainRoot"
        AutomationProperties.AutomationId="AppShell"
        SizeChanged="MainRoot_SizeChanged">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="AudioPlayerIconButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="{StaticResource KoukeiControlTargetSize}" />
                    <Setter Property="Height" Value="{StaticResource KoukeiControlTargetSize}" />
                    <Setter Property="MinWidth" Value="{StaticResource KoukeiControlTargetSize}" />
                    <Setter Property="MinHeight" Value="{StaticResource KoukeiControlTargetSize}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Foreground" Value="{ThemeResource KoukeiTextPrimaryBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border
                                        x:Name="ButtonBackground"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                    <ContentPresenter
                                        x:Name="ButtonContent"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="AudioPlayerVolumeSliderStyle" TargetType="Slider">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="116" />
                    <Setter Property="MinWidth" Value="32" />
                    <Setter Property="MinHeight" Value="116" />
                    <Setter Property="Background" Value="{ThemeResource SliderTrackFill}" />
                    <Setter Property="Foreground" Value="{ThemeResource KoukeiTextPrimaryBrush}" />
                </Style>

                <Style x:Key="AudioPlayerPrimaryButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="{StaticResource KoukeiPrimaryPlaybackTargetSize}" />
                    <Setter Property="Height" Value="{StaticResource KoukeiPrimaryPlaybackTargetSize}" />
                    <Setter Property="MinWidth" Value="{StaticResource KoukeiPrimaryPlaybackTargetSize}" />
                    <Setter Property="MinHeight" Value="{StaticResource KoukeiPrimaryPlaybackTargetSize}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="24" />
                    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PrimaryButtonBackground" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PrimaryButtonBackground" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="PrimaryButtonContent" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border
                                        x:Name="PrimaryButtonBackground"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                    <ContentPresenter
                                        x:Name="PrimaryButtonContent"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="TitleBar"
            Title="Koukei"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind RootFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlaybackQueueResizeColumn" Width="0" />
                <ColumnDefinition x:Name="PlaybackQueueSidebarColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource KoukeiPageBackgroundBrush}"
                BorderBrush="{ThemeResource KoukeiCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource KoukeiCornerRadiusMedium}">
                <NavigationView
                    x:Name="NavigationViewControl"
                    AutomationProperties.AutomationId="PrimaryNavigation"
                    Background="Transparent"
                    DisplayModeChanged="OnPaneDisplayModeChanged"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsTabStop="False"
                    Loaded="OnNavigationViewControlLoaded"
                    SelectionChanged="OnNavigationViewSelectionChanged">
                    <Frame x:Name="RootFrame" />
                    <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="Home"
                        x:Uid="MainWindow_Home"
                        AutomationProperties.AutomationId="NavHome"
                        Icon="Home" />
                    <NavigationViewItem
                        x:Name="MediaLibrary"
                        x:Uid="MainWindow_Library"
                        AutomationProperties.AutomationId="NavMediaLibrary"
                        IsExpanded="True"
                        SelectsOnInvoked="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.MenuItems>
                            <NavigationViewItem
                                x:Name="VideoLibrary"
                                x:Uid="MainWindow_VideoLibrary"
                                AutomationProperties.AutomationId="NavVideoLibrary">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8B2;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem
                                x:Name="AudioLibrary"
                                x:Uid="MainWindow_AudioLibrary"
                                AutomationProperties.AutomationId="NavAudioLibrary">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8D6;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="Playlists"
                        x:Uid="MainWindow_Playlists"
                        AutomationProperties.AutomationId="NavPlaylists"
                        Icon="Bookmarks"
                        SelectsOnInvoked="True" />
                    </NavigationView.MenuItems>
                    <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        x:Name="PlaybackQueueNavigationItem"
                        x:Uid="MainWindow_PlaybackQueue"
                        AutomationProperties.AutomationId="NavPlaybackQueue"
                        KeyDown="PlaybackQueueNavigationItem_KeyDown"
                        SelectsOnInvoked="False"
                        Tapped="PlaybackQueueNavigationItem_Tapped">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEA37;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    </NavigationView.FooterMenuItems>
                </NavigationView>
            </Border>

            <Border
                x:Name="PlaybackQueueOverlayScrim"
                Grid.ColumnSpan="3"
                Background="{ThemeResource KoukeiOverlayScrimBrush}"
                Tapped="PlaybackQueueOverlayScrim_Tapped"
                Visibility="Collapsed" />

            <local:HorizontalResizeHandle
                x:Name="PlaybackQueueResizeHandle"
                x:Uid="PlaybackQueueSidebar_ResizeHandle"
                Grid.Column="1"
                IsTabStop="True"
                KeyDown="PlaybackQueueResizeHandle_KeyDown"
                Background="Transparent"
                PointerCanceled="PlaybackQueueResizeHandle_PointerCanceled"
                PointerCaptureLost="PlaybackQueueResizeHandle_PointerCaptureLost"
                PointerMoved="PlaybackQueueResizeHandle_PointerMoved"
                PointerPressed="PlaybackQueueResizeHandle_PointerPressed"
                PointerReleased="PlaybackQueueResizeHandle_PointerReleased"
                Visibility="Collapsed">
                <local:HorizontalResizeHandle.Template>
                    <ControlTemplate TargetType="local:HorizontalResizeHandle">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </local:HorizontalResizeHandle.Template>
                <Border
                    x:Name="PlaybackQueueResizeIndicator"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:HorizontalResizeHandle>

            <Border
                x:Name="PlaybackQueueSidebar"
                Grid.Column="2"
                Padding="16"
                Background="{ThemeResource KoukeiSurfacePrimaryBrush}"
                BorderBrush="{ThemeResource KoukeiCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource KoukeiCornerRadiusMedium}"
                Visibility="Collapsed">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="PlaybackQueueSidebar_Title"
                            FontSize="20"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="PlaybackQueueSidebarCloseButton"
                            x:Uid="PlaybackQueueSidebar_CloseButton"
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Click="PlaybackQueueSidebarCloseButton_Click">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="PlaybackQueueSidebarList"
                            x:Uid="PlaybackQueueSidebar_List"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DoubleTapped="PlaybackQueueSidebarList_DoubleTapped"
                            DragItemsCompleted="PlaybackQueueSidebarList_DragItemsCompleted"
                            DragItemsStarting="PlaybackQueueSidebarList_DragItemsStarting"
                            ItemsSource="{x:Bind PlaybackQueueSidebarItems}"
                            ItemContainerStyle="{StaticResource KoukeiPlaybackQueueItemContainerStyle}"
                            Padding="0"
                            ReorderMode="Enabled"
                            SelectionMode="Single">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PlaybackQueueSidebarItem">
                                    <Grid MinHeight="62" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            x:Uid="PlaybackQueueSidebar_CurrentIndicator"
                                            Width="3"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="2"
                                            Visibility="{x:Bind CurrentIndicatorVisibility, Mode=OneWay}" />

                                        <FontIcon
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="22"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind KindGlyph, Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                helpers:LongTextToolTip.FullText="{x:Bind TitleToolTipText, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind FileName, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                helpers:LongTextToolTip.FullText="{x:Bind FilePath, Mode=OneWay}" />
                                        </StackPanel>

                                        <Button
                                            x:Uid="PlaybackQueueSidebar_PlayButton"
                                            Grid.Column="3"
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            Click="PlaybackQueueSidebarPlayButton_Click"
                                            Tag="{x:Bind}">
                                            <FontIcon FontSize="13" Glyph="&#xE768;" />
                                        </Button>

                                        <Button
                                            x:Uid="PlaybackQueueSidebar_RemoveButton"
                                            Grid.Column="4"
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            Click="PlaybackQueueSidebarRemoveButton_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind RemoveVisibility, Mode=OneWay}">
                                            <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="PlaybackQueueSidebarEmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                            <FontIcon
                                FontSize="42"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xEA37;" />
                            <TextBlock
                                x:Uid="PlaybackQueueSidebar_Empty"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PlaybackQueueSidebarCountText"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="PlaybackQueueSidebarSaveButton"
                            x:Uid="PlaybackQueueSidebar_SaveButton"
                            Grid.Column="1"
                            Style="{StaticResource KoukeiIconButtonStyle}"
                            Click="PlaybackQueueSidebarSaveButton_Click">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        </Button>
                        <Button
                            x:Name="PlaybackQueueSidebarClearButton"
                            x:Uid="PlaybackQueueSidebar_ClearButton"
                            Grid.Column="2"
                            Click="PlaybackQueueSidebarClearButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="AudioExpandedLayer"
            Grid.Row="1"
            Canvas.ZIndex="20"
            Background="{ThemeResource KoukeiOverlayScrimBrush}"
            Tapped="AudioExpandedBackdrop_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="AudioExpandedPanel"
                MinHeight="0"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource KoukeiOpaquePageBackgroundBrush}"
                BorderThickness="0"
                CornerRadius="0"
                Tapped="AudioExpandedPanel_Tapped">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ExpandedArtworkColumn" Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ExpandedArtworkContainer"
                        Width="220"
                        Height="220"
                        Background="{ThemeResource KoukeiSurfaceSecondaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <Grid
                                x:Name="ExpandedArtworkFallback"
                                Width="220"
                                Height="220"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource KoukeiSurfaceSecondaryBrush}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="64"
                                    Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                    Glyph="&#xE8D6;" />
                            </Grid>
                            <Image
                                x:Name="ExpandedArtworkImage"
                                Width="220"
                                Height="220"
                                Stretch="UniformToFill"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ExpandedAudioMetadataPanel" Spacing="3">
                                <TextBlock
                                    x:Name="ExpandedAudioTitleText"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ExpandedAudioArtistText"
                                    Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ExpandedAudioAlbumText"
                                    Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                x:Name="AudioCollapseButton"
                                x:Uid="AudioPlayer_CollapseButton"
                                Grid.Column="1"
                                Style="{StaticResource AudioPlayerIconButtonStyle}"
                                Click="AudioCollapseButton_Click">
                                <FontIcon FontSize="20" Glyph="&#xE70D;" />
                            </Button>
                        </Grid>

                        <TextBlock
                            x:Name="ExpandedAudioStatusText"
                            Grid.Row="1"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <Border
                            Grid.Row="2"
                            MinHeight="150"
                            Background="{ThemeResource KoukeiSurfaceSecondaryBrush}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="16,12,16,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                        Glyph="&#xE8D6;" />
                                    <TextBlock
                                        x:Uid="AudioPlayer_LyricsTitle"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="ExpandedLyricsSourceText"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                        Visibility="Collapsed" />
                                </Grid>

                                <ListView
                                    x:Name="ExpandedLyricsList"
                                    Grid.Row="1"
                                    IsItemClickEnabled="True"
                                    ItemClick="ExpandedLyricsList_ItemClick"
                                    ItemsSource="{x:Bind AudioLyricLines}"
                                    SelectionMode="None"
                                    Visibility="Collapsed">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                                        </TransitionCollection>
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:AudioLyricLineViewModel">
                                            <Grid
                                                Padding="16,7"
                                                ColumnSpacing="10"
                                                ToolTipService.ToolTip="{x:Bind TimestampLabel}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="2"
                                                    Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="17"
                                                    FontWeight="{x:Bind DisplayFontWeight, Mode=OneWay}"
                                                    Opacity="{x:Bind DisplayOpacity, Mode=OneWay}"
                                                Text="{x:Bind Text}"
                                                TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel
                                    x:Name="ExpandedLyricsLoadingPanel"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Visibility="Collapsed">
                                    <ProgressRing Width="20" Height="20" IsActive="True" />
                                    <TextBlock
                                        x:Uid="AudioPlayer_LyricsLoading"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource KoukeiTextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel
                                    x:Name="ExpandedLyricsEmptyPanel"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    Spacing="5">
                                    <TextBlock
                                        x:Uid="AudioPlayer_LyricsEmptyTitle"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Uid="AudioPlayer_LyricsEmptyDescription"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="AudioPlayerBar"
            Grid.Row="2"
            Canvas.ZIndex="30"
            Height="78"
            Padding="14,0"
            Background="{ThemeResource KoukeiSurfacePrimaryBrush}"
            BorderBrush="{ThemeResource KoukeiCardStrokeBrush}"
            BorderThickness="0,1,0,0"
            Opacity="0"
            SizeChanged="AudioPlayerBar_SizeChanged"
            Visibility="Collapsed">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompactLeftControlsColumn" Width="300" />
                    <ColumnDefinition x:Name="CompactNowPlayingColumn" Width="*" />
                    <ColumnDefinition x:Name="CompactRightControlsColumn" Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="CompactLeftControls"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="CompactShuffleButton"
                        x:Uid="AudioPlayer_ShuffleButton"
                        IsEnabled="False"
                        Style="{StaticResource AudioPlayerIconButtonStyle}"
                        Click="AudioShuffleButton_Click">
                        <Grid Width="22" Height="24">
                            <FontIcon
                                x:Name="CompactShuffleInactiveIcon"
                                Height="20"
                                VerticalAlignment="Top"
                                FontSize="20"
                                Foreground="{ThemeResource KoukeiTextPrimaryBrush}"
                                Glyph="&#xE8B1;" />
                            <Grid x:Name="CompactShuffleActiveIcon" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="4" />
                                </Grid.RowDefinitions>
                                <FontIcon
                                    Height="20"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B1;" />
                                <Ellipse
                                    Grid.Row="1"
                                    Width="4"
                                    Height="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button x:Name="CompactPreviousButton" x:Uid="AudioPlayer_PreviousButton" Style="{StaticResource AudioPlayerIconButtonStyle}" Click="AudioPreviousButton_Click">
                        <FontIcon FontSize="20" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="CompactPlayPauseButton"
                        x:Uid="AudioPlayer_PlayPauseButton"
                        Style="{StaticResource AudioPlayerPrimaryButtonStyle}"
                        Click="AudioPlayPauseButton_Click">
                        <Grid Width="22" Height="22">
                            <FontIcon
                                x:Name="CompactPlayPauseIcon"
                                FontSize="20"
                                Glyph="&#xE768;" />
                            <ProgressRing
                                x:Name="CompactPlaybackLoadingRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CompactNextButton" x:Uid="AudioPlayer_NextButton" Style="{StaticResource AudioPlayerIconButtonStyle}" Click="AudioNextButton_Click">
                        <FontIcon FontSize="20" Glyph="&#xE893;" />
                    </Button>
                    <Button
                        x:Name="CompactRepeatButton"
                        x:Uid="AudioPlayer_RepeatButton"
                        IsEnabled="False"
                        Style="{StaticResource AudioPlayerIconButtonStyle}"
                        Click="AudioRepeatButton_Click">
                        <Grid Width="22" Height="24">
                            <FontIcon
                                x:Name="CompactRepeatInactiveIcon"
                                Height="20"
                                VerticalAlignment="Top"
                                FontSize="20"
                                Foreground="{ThemeResource KoukeiTextPrimaryBrush}"
                                Glyph="&#xE8EE;" />
                            <Grid x:Name="CompactRepeatActiveIcon" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="4" />
                                </Grid.RowDefinitions>
                                <FontIcon
                                    x:Name="CompactRepeatActiveGlyph"
                                    Height="20"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8EE;" />
                                <Ellipse
                                    Grid.Row="1"
                                    Width="4"
                                    Height="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    MaxWidth="804"
                    Height="72"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{ThemeResource KoukeiSurfaceSecondaryBrush}"
                    BorderBrush="{ThemeResource KoukeiCardStrokeBrush}"
                    BorderThickness="1,0"
                    CornerRadius="{StaticResource KoukeiCornerRadiusSmall}">
    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AudioNowPlayingButton"
                            x:Uid="AudioPlayer_NowPlayingButton"
                            Width="72"
                            Height="72"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AudioArtworkButton_Click"
                            CornerRadius="{StaticResource KoukeiCornerRadiusSmall}">
                            <Border
                                x:Name="CompactArtworkContainer"
                                Width="72"
                                Height="72"
                                Background="{ThemeResource KoukeiSurfaceSecondaryBrush}"
                                BorderBrush="{ThemeResource KoukeiCardStrokeBrush}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="{StaticResource KoukeiCornerRadiusSmall}">
                                <Grid>
                                    <Grid
                                        x:Name="CompactArtworkFallback"
                                        Width="72"
                                        Height="72"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource KoukeiSurfaceSecondaryBrush}">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="30"
                                            Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                            Glyph="&#xE8D6;" />
                                    </Grid>
                                    <Image
                                        x:Name="CompactArtworkImage"
                                        Width="72"
                                        Height="72"
                                        Stretch="UniformToFill"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Button>
                        <StackPanel
                            x:Name="CompactAudioMetadataPanel"
                            Grid.Column="1"
                            Margin="0,4,0,0"
                            Padding="18,0,8,0"
                            VerticalAlignment="Top"
                            Spacing="2">
                            <TextBlock
                                x:Name="CompactAudioTitleText"
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CompactAudioArtistText"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid
                            x:Name="CompactTimePanel"
                            Grid.ColumnSpan="3"
                            Margin="80,0,8,20"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False">
                            <TextBlock
                                x:Name="CompactCurrentTimeText"
                                HorizontalAlignment="Left"
                                FontSize="11"
                                Foreground="{ThemeResource KoukeiTextSecondaryBrush}" />
                            <TextBlock
                                x:Name="CompactDurationText"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="{ThemeResource KoukeiTextSecondaryBrush}" />
                        </Grid>
                        <controls:PlayerSeekBar
                            x:Name="CompactAudioSeekBar"
                            Grid.ColumnSpan="3"
                            Height="40"
                            Margin="72,0,0,0"
                            VerticalAlignment="Bottom"
                            IsEnabled="False"
                            Maximum="1"
                            SmallChange="5"
                            TrackVerticalOffset="8"
                            SeekCompleted="AudioSeekBar_SeekCompleted"
                            SeekStarted="AudioSeekBar_SeekStarted"
                            ValueChanged="AudioSeekBar_ValueChanged" />
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="CompactRightControls"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="CompactMuteButton"
                        x:Uid="AudioPlayer_MuteButton"
                        Style="{StaticResource AudioPlayerIconButtonStyle}"
                        Click="CompactMuteButton_Click">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout
                                x:Name="CompactVolumeFlyout"
                                Placement="Top"
                                ShowMode="Transient"
                                Closed="CompactVolumeFlyout_Closed"
                                Opened="CompactVolumeFlyout_Opened">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Border
                                    Width="58"
                                    Padding="10,10,10,12"
                                    Background="{ThemeResource KoukeiSurfacePrimaryBrush}"
                                    CornerRadius="6"
                                    Loaded="CompactVolumeFlyout_Loaded">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="116" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            x:Name="CompactVolumeValueText"
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource KoukeiTextSecondaryBrush}"
                                            Text="100%" />
                                        <Slider
                                            x:Name="CompactVolumeSlider"
                                            x:Uid="AudioPlayer_VolumeSlider"
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            Orientation="Vertical"
                                            Style="{StaticResource AudioPlayerVolumeSliderStyle}" />
                                    </Grid>
                                </Border>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <FontIcon x:Name="CompactMuteIcon" FontSize="20" Glyph="&#xE767;" />
                    </Button>
                    <Button
                        x:Name="CompactMoreButton"
                        x:Uid="AudioPlayer_MoreButton"
                        Style="{StaticResource AudioPlayerIconButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="CompactMorePreviousItem"
                                    x:Uid="AudioPlayer_PreviousMenuItem"
                                    Click="AudioPreviousButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE892;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="CompactMoreNextItem"
                                    x:Uid="AudioPlayer_NextMenuItem"
                                    Click="AudioNextButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE893;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="CompactMoreTransportSeparator" />
                                <MenuFlyoutItem
                                    x:Name="CompactMoreShuffleItem"
                                    x:Uid="AudioPlayer_ShuffleMenuItem"
                                    Click="AudioShuffleButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="CompactMoreRepeatItem"
                                    x:Uid="AudioPlayer_RepeatMenuItem"
                                    Click="AudioRepeatButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon x:Name="CompactMoreRepeatIcon" Glyph="&#xE8EE;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon FontSize="20" Glyph="&#xE712;" />
                    </Button>
                    <Button x:Name="AudioCloseButton" x:Uid="AudioPlayer_CloseButton" Style="{StaticResource AudioPlayerIconButtonStyle}" Click="AudioCloseButton_Click">
                        <FontIcon FontSize="20" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
