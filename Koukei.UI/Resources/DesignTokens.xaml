<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing is intentionally limited to the shared 4/8/12/16/24/32/40 scale. -->
    <x:Double x:Key="KoukeiSpace4">4</x:Double>
    <x:Double x:Key="KoukeiSpace8">8</x:Double>
    <x:Double x:Key="KoukeiSpace12">12</x:Double>
    <x:Double x:Key="KoukeiSpace16">16</x:Double>
    <x:Double x:Key="KoukeiSpace24">24</x:Double>
    <x:Double x:Key="KoukeiSpace32">32</x:Double>
    <x:Double x:Key="KoukeiSpace40">40</x:Double>

    <x:Double x:Key="KoukeiPageSectionSpacing">24</x:Double>
    <x:Double x:Key="KoukeiPageBlockSpacing">16</x:Double>
    <x:Double x:Key="KoukeiPageRelatedSpacing">8</x:Double>

    <Thickness x:Key="KoukeiPagePaddingCompact">16</Thickness>
    <Thickness x:Key="KoukeiPagePaddingMedium">24</Thickness>
    <Thickness x:Key="KoukeiPagePaddingWide">40</Thickness>
    <Thickness x:Key="KoukeiCardPadding">16</Thickness>
    <Thickness x:Key="KoukeiControlPadding">12,8</Thickness>

    <CornerRadius x:Key="KoukeiCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="KoukeiCornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="KoukeiCornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="KoukeiCornerRadiusRound">999</CornerRadius>

    <x:Double x:Key="KoukeiControlTargetSize">40</x:Double>
    <x:Double x:Key="KoukeiCommandBarTargetSize">48</x:Double>
    <x:Double x:Key="KoukeiPrimaryPlaybackTargetSize">48</x:Double>
    <x:Double x:Key="KoukeiPageContentMaxWidth">1440</x:Double>
    <x:Double x:Key="KoukeiSettingsContentMaxWidth">840</x:Double>

    <!-- Milliseconds. MotionHelper remains the authority for the system animation setting. -->
    <x:Double x:Key="KoukeiMotionFastMilliseconds">120</x:Double>
    <x:Double x:Key="KoukeiMotionStandardMilliseconds">180</x:Double>
    <x:Double x:Key="KoukeiMotionPanelMilliseconds">220</x:Double>
    <x:Double x:Key="KoukeiMotionPanelExitMilliseconds">120</x:Double>
    <x:Double x:Key="KoukeiMotionDistanceSmall">8</x:Double>
    <x:Double x:Key="KoukeiMotionDistancePlayer">12</x:Double>
    <x:Double x:Key="KoukeiMotionDistancePanel">16</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="KoukeiPageBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="KoukeiOpaquePageBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="KoukeiSurfacePrimaryBrush" Color="#F9FFFFFF" />
            <SolidColorBrush x:Key="KoukeiSurfaceSecondaryBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="KoukeiCardStrokeBrush" Color="#18000000" />
            <SolidColorBrush x:Key="KoukeiOverlayScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="KoukeiTextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="KoukeiTextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="KoukeiPlaybackAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="KoukeiFavoriteActiveBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="KoukeiCriticalBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MediaLibraryGridDurationForegroundBrush" Color="#FF000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="KoukeiPageBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="KoukeiOpaquePageBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="KoukeiSurfacePrimaryBrush" Color="#EE202020" />
            <SolidColorBrush x:Key="KoukeiSurfaceSecondaryBrush" Color="#E82B2B2B" />
            <SolidColorBrush x:Key="KoukeiCardStrokeBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="KoukeiOverlayScrimBrush" Color="#99000000" />
            <SolidColorBrush x:Key="KoukeiTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="KoukeiTextSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="KoukeiPlaybackAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="KoukeiFavoriteActiveBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="KoukeiCriticalBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MediaLibraryGridDurationForegroundBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="KoukeiPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KoukeiOpaquePageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KoukeiSurfacePrimaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KoukeiSurfaceSecondaryBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="KoukeiCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KoukeiOverlayScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KoukeiTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KoukeiTextSecondaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="KoukeiPlaybackAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="KoukeiFavoriteActiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="KoukeiCriticalBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MediaLibraryGridDurationForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="KoukeiPageBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="KoukeiOpaquePageBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="KoukeiSurfacePrimaryBrush" Color="#EE202020" />
            <SolidColorBrush x:Key="KoukeiSurfaceSecondaryBrush" Color="#E82B2B2B" />
            <SolidColorBrush x:Key="KoukeiCardStrokeBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="KoukeiOverlayScrimBrush" Color="#99000000" />
            <SolidColorBrush x:Key="KoukeiTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="KoukeiTextSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="KoukeiPlaybackAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="KoukeiFavoriteActiveBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="KoukeiCriticalBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="KoukeiOnImageBadgeForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MediaLibraryGridDurationForegroundBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
